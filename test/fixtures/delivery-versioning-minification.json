{
  "packageVersionSource": "package.json#version",
  "runtimeAssetNames": [
    "runtime-prelude.js",
    "worker-prelude.js",
    "sw.js",
    "zp-core.js",
    "http-rewriter.js",
    "rust-rewriter.js",
    "rust-rewriter.wasm"
  ],
  "bundling": {
    "format": "classic-iife",
    "hashNames": false,
    "reason": "service worker/runtime references fixed asset names"
  },
  "minification": {
    "default": false,
    "flag": "--minify",
    "abiSafeRequirement": "hidden public APIs and ZP helper names must remain stable"
  },
  "rewriterVersion": "phase3-rust-wasm-ast-4-import-map"
}
