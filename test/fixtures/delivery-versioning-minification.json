{
  "packageVersionSource": "package.json#version",
  "runtimeAssetNames": [
    "host-shell.js",
    "runtime-prelude.js",
    "worker-prelude.js",
    "zp-core.js",
    "network-worker.js",
    "quickjs-runtime.mjs",
    "quickjs-runtime.wasm"
  ],
  "removedRuntimeAssets": ["http-rewriter.js", "rust-rewriter.js", "rust-rewriter.wasm"],
  "bundling": {
    "format": "classic-iife",
    "hashNames": false,
    "reason": "host shell/runtime references fixed asset names"
  },
  "minification": {
    "default": false,
    "flag": "--minify",
    "abiSafeRequirement": "hidden public APIs and ZP helper names must remain stable"
  },
  "quickjsRuntime": "source-built-quickjs-ng"
}
