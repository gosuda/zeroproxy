{
  "schema": "zp.rewriter.parser-codegen-selection.v1",
  "javascript": {
    "parser": "swc_ecma_parser",
    "codegen": "swc_ecma_codegen",
    "resolver": "swc_ecma_transforms_base::resolver",
    "syntax": ["jsx", "import_attributes", "EsVersion::latest"],
    "selectionReasons": [
      "single Rust-owned AST parse/rewrite/codegen path for classic and module scripts",
      "resolver marks preserve local bindings while identifying unresolved globals",
      "codegen emits rewritten JavaScript without a JavaScript fallback asset"
    ],
    "sourceNeedles": [
      "use swc_ecma_parser::{lexer::Lexer, EsSyntax, Parser, StringInput, Syntax};",
      "use swc_ecma_codegen::{text_writer::JsWriter, Emitter};",
      "use swc_ecma_transforms_base::resolver;",
      "program.visit_mut_with(&mut resolver(unresolved_mark, top_level_mark, false));",
      "Config::default().with_minify(true)"
    ],
    "manifestDependencies": [
      "swc_ecma_ast",
      "swc_ecma_codegen",
      "swc_ecma_parser",
      "swc_ecma_transforms_base",
      "swc_ecma_visit"
    ]
  },
  "html": {
    "parserRewriter": "lol_html",
    "sourceNeedles": ["lol_html", "rewrite_str"]
  },
  "css": {
    "parser": "swc_css_parser",
    "codegen": "swc_css_codegen",
    "manifestDependencies": ["swc_css_ast", "swc_css_codegen", "swc_css_parser", "swc_css_visit"]
  }
}
