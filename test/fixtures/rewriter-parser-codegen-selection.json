{
  "schema": "zp.rewriter.parser-codegen-selection.v2",
  "javascript": {
    "status": "removed-from-target-hot-path",
    "selectionReasons": [
      "target classic scripts and modules execute as source inside QuickJS",
      "native-browser whole-program JavaScript AST/codegen is excluded by PLAN.md Phase 10",
      "dynamic code uses QuickJS compile/eval semantics instead of Rust re-emission"
    ],
    "forbiddenSourceNeedles": [
      "virtual:zeroproxy-rust-rewriter",
      "ZPHTTPRewriter",
      "rewriteScriptSource",
      "rewriteFunctionBody",
      "wasm_bindgen.rewrite_script_with_context"
    ]
  },
  "html": {
    "activeParser": "golang.org/x/net/html",
    "source": "internal/htmlsanitize/sanitize.go",
    "sourceNeedles": ["html.Parse", "SanitizeDocument"]
  },
  "css": {
    "activeParser": "github.com/tdewolff/parse/v2/css",
    "source": "internal/cssrewrite/rewrite.go",
    "sourceNeedles": ["github.com/tdewolff/parse/v2/css", "css.NewLexer"]
  }
}
