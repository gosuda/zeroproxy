    "priority": "p0",
    "axes": ["mode", "credentials", "cors same-origin", "cookie projection"],
    "probes": [
      "same-origin include",
      "cross-origin cors",
      "credentials omit",
      "credentialed redirect"
    ],
    "existingNeedles": ["X-ZP-Fetch-Credentials", "X-ZP-Fetch-Mode", "fetchThroughRuntime"],
    "behaviorOracle": {
      "fixture": "fetch-mode-credentials-oracle",
      "requests": [
        {
          "mode": "same-origin",
          "credentials": "include",
          "expectedCookieProjection": "same-origin-jar"
        },
        {
          "mode": "cors",
          "credentials": "omit",
          "expectedCookieProjection": "none"
        },
        {
          "mode": "cors",
          "credentials": "include",
          "expectedCookieProjection": "credentialed-cors-jar"
        }
      ],
      "expectedResponses": ["success", "cors-policy-failure"],
      "failureClasses": ["cors-policy", "credential-projection"]
    },
    "failureClasses": ["cors-policy", "credential-projection"],
    "telemetrySurface": "network-api"
  },
