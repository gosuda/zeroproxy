[
  {
    "id": "redirect-chain-set-cookie",
    "priority": "p0",
    "surface": "redirect chain cookies",
    "probes": [
      "Set-Cookie on 30x response",
      "final request Cookie header",
      "document.cookie visibility after final load"
    ],
    "redaction": ["cookie names only", "value length bucket", "SameSite enum"],
    "existingNeedles": ["Set-Cookie", "Cookie", "documentCookieString"],
    "behaviorOracle": {
      "fixture": "redirect-chain-cookie-oracle",
      "stimulus": [
        "302 Set-Cookie sid=alpha; SameSite=Lax",
        "200 Set-Cookie pref=beta; SameSite=None; Secure",
        "final document read"
      ],
      "expectedState": {
        "cookieNames": ["pref", "sid"],
        "networkCookieNames": ["pref", "sid"],
        "documentCookieNames": ["pref", "sid"],
        "sameSiteClasses": ["Lax", "None"]
      },
      "redactedEvidence": {
        "cookieNames": ["pref", "sid"],
        "valueLengthBuckets": ["short", "short"],
        "sameSiteClasses": ["Lax", "None"],
        "httpOnlyNames": []
      },
      "forbiddenEvidence": ["alpha", "beta", "sid=alpha", "pref=beta"]
    }
  },
