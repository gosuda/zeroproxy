[
  {
    "id": "add-remove-identity",
    "priority": "p0",
    "apis": ["addEventListener", "removeEventListener"],
    "probes": [
      "same listener identity",
      "duplicate registration",
      "remove with capture mismatch",
      "handleEvent object identity"
    ],
    "existingNeedles": ["addEventListener", "removeEventListener", "handleEvent"],
    "behaviorOracle": {
      "fixture": "event-listener-identity-oracle",
      "scenarios": [
        {
          "case": "same-function-removed-once",
          "expectedCalls": 0
        },
        {
          "case": "duplicate-registration-deduped",
          "expectedCalls": 1
        },
        {
          "case": "handleEvent-object-removal",
          "expectedCallsAfterRemove": 0
        },
        {
          "case": "capture-mismatch-not-removed",
          "expectedCallsAfterWrongRemove": 1
        }
      ],
      "expectedOrder": ["target-listener"],
      "targetVisibleKeys": []
    }
  },
  {
    "id": "listener-options",
    "priority": "p0",
    "apis": ["addEventListener options"],
    "probes": ["capture", "once", "passive", "signal abort", "boolean options"],
    "existingNeedles": ["capture", "once", "passive", "signal"],
    "behaviorOracle": {
      "fixture": "event-listener-options-oracle",
      "scenarios": [
        {
          "case": "once",
          "dispatches": 2,
          "expectedCalls": 1
        },
        {
          "case": "abort-signal-before-dispatch",
          "expectedCalls": 0
        },
        {
          "case": "passive-prevent-default",
          "expectedDefaultPrevented": false
        },
        {
          "case": "boolean-capture",
          "expectedPhase": "capture"
        }
      ],
      "expectedOrder": ["capture", "target", "bubble"],
      "targetVisibleKeys": []
    }
  },
  {
    "id": "dispatch-propagation-order",
    "priority": "p0",
    "apis": ["dispatchEvent"],
    "probes": [
      "capture target bubble order",
      "stopPropagation",
      "stopImmediatePropagation",
      "preventDefault return value"
    ],
    "existingNeedles": ["dispatchEvent", "stopImmediatePropagation", "preventDefault"],
    "behaviorOracle": {
      "fixture": "event-dispatch-order-oracle",
      "scenarios": [
        {
          "case": "capture-target-bubble",
          "expectedOrder": ["parent-capture", "target-capture", "target-bubble", "parent-bubble"]
        },
        {
          "case": "stopPropagation",
          "expectedSkipped": ["parent-bubble"]
        },
        {
          "case": "stopImmediatePropagation",
          "expectedSkipped": ["sibling-listener"]
        },
        {
          "case": "cancelable-preventDefault",
          "expectedDispatchReturn": false
        }
      ],
      "expectedOrder": ["parent-capture", "target-capture", "target-bubble", "parent-bubble"],
      "targetVisibleKeys": []
    }
  },
