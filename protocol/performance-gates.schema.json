{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance-gates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "reference_platform", "toolchains_sha256", "browser_boundaries_sha256", "browser_lanes", "deferred_browser_families", "packet_capture", "cache_modes", "fixtures", "warmups", "measured_pairs", "pair_order", "bootstrap_resamples", "aggregation", "variance", "metric_definitions", "gates", "site_classes", "leak_tolerances", "v1_aggregate", "soak"],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "minLength": 1},
    "reference_platform": {"type": "object", "additionalProperties": false, "required": ["os", "arch", "hardware"], "properties": {"os": {"type": "string", "minLength": 1}, "arch": {"type": "string", "minLength": 1}, "hardware": {"$ref": "#/$defs/hardware"}}},
    "toolchains_sha256": {"$ref": "#/$defs/sha256"},
    "browser_boundaries_sha256": {"$ref": "#/$defs/sha256"},
    "browser_lanes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/browser_lane"}},
    "deferred_browser_families": {"const": []},
    "packet_capture": {"type": "object", "additionalProperties": false, "required": ["backend", "interface", "availability", "privilege", "reason", "certified"], "properties": {"backend": {"const": "tcpdump"}, "interface": {"type": "string"}, "availability": {"enum": ["available", "unavailable"]}, "privilege": {"enum": ["available", "unavailable"]}, "reason": {"type": "string"}, "certified": {"type": "boolean"}}},
    "cache_modes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["cold", "warm"]}},
    "fixtures": {"type": "array", "minItems": 15, "items": {"$ref": "#/$defs/fixture"}},
    "warmups": {"const": 5},
    "measured_pairs": {"const": 30},
    "pair_order": {"const": "alternating-native-mediated"},
    "bootstrap_resamples": {"const": 10000},
    "aggregation": {"type": "object", "additionalProperties": false, "required": ["percentiles", "threshold_percentile", "paired_bootstrap_confidence", "paired_bootstrap_bound"], "properties": {"percentiles": {"const": [0.5, 0.95, 0.99]}, "threshold_percentile": {"const": 0.95}, "paired_bootstrap_confidence": {"const": 0.95}, "paired_bootstrap_bound": {"const": "upper"}}},
    "variance": {"type": "object", "additionalProperties": false, "required": ["max_cv", "on_exceed"], "properties": {"max_cv": {"const": 0.1}, "on_exceed": {"const": "invalidate"}}},
    "metric_definitions": {"type": "object", "additionalProperties": false, "required": ["latency_ms", "throughput_mib_s", "asset_transfer_bytes", "memory_bytes", "queue_depth", "site_deltas"], "additionalProperties": false, "properties": {"latency_ms": {"$ref": "#/$defs/metric"}, "throughput_mib_s": {"$ref": "#/$defs/metric"}, "asset_transfer_bytes": {"$ref": "#/$defs/metric"}, "memory_bytes": {"$ref": "#/$defs/metric"}, "queue_depth": {"$ref": "#/$defs/metric"}, "site_deltas": {"$ref": "#/$defs/metric"}}},
    "gates": {"type": "object", "minProperties": 14, "additionalProperties": {"type": "number", "minimum": 0}},
    "site_classes": {"type": "object", "additionalProperties": false, "required": ["content", "application", "editor_media_pwa"], "properties": {"content": {"$ref": "#/$defs/site_class"}, "application": {"$ref": "#/$defs/site_class"}, "editor_media_pwa": {"$ref": "#/$defs/site_class"}}},
    "leak_tolerances": {"type": "object", "additionalProperties": false, "required": ["performance", "soak"], "properties": {"performance": {"type": "object", "additionalProperties": false, "required": ["memory_growth_bytes", "queue_growth"], "properties": {"memory_growth_bytes": {"type": "number", "minimum": 0}, "queue_growth": {"type": "number", "minimum": 0}}}, "soak": {"type": "object", "additionalProperties": false, "required": ["closed_counts_must_be_zero", "fd_growth_max", "goroutine_growth_max", "fd_slope_per_hour_max", "goroutine_slope_per_hour_max", "rss_growth_relative_max", "rss_growth_bytes_floor", "rss_slope_bytes_per_hour_max", "no_post_stop_monotonic_growth"], "properties": {"closed_counts_must_be_zero": {"type": "array", "minItems": 5, "items": {"enum": ["route", "port", "stream", "worker", "realm"]}}, "fd_growth_max": {"type": "number", "minimum": 0}, "goroutine_growth_max": {"type": "number", "minimum": 0}, "fd_slope_per_hour_max": {"type": "number", "minimum": 0}, "goroutine_slope_per_hour_max": {"type": "number", "minimum": 0}, "rss_growth_relative_max": {"type": "number", "minimum": 0}, "rss_growth_bytes_floor": {"type": "number", "minimum": 0}, "rss_slope_bytes_per_hour_max": {"type": "number", "minimum": 0}, "no_post_stop_monotonic_growth": {"const": true}}}}},
    "v1_aggregate": {"type": "object", "additionalProperties": false, "required": ["metrics", "geometric_mean_overhead_reduction_min", "non_worse_fixture_fraction_min", "class_p95_regression_max", "zero_baseline_policy"], "properties": {"metrics": {"const": ["dcl_delta", "lcp_delta", "cpu_delta"]}, "geometric_mean_overhead_reduction_min": {"const": 0.3}, "non_worse_fixture_fraction_min": {"const": 0.8}, "class_p95_regression_max": {"const": 0.05}, "zero_baseline_policy": {"const": "must-remain-zero"}}},
    "soak": {"type": "object", "additionalProperties": false, "required": ["hours", "warmup_minutes", "quiescence_minutes", "origins", "clients", "short_streams", "sse_streams", "websockets", "navigations_per_origin_per_minute", "abort_churn", "max_memory_bytes", "max_queue_depth"], "properties": {"hours": {"const": 8}, "warmup_minutes": {"const": 30}, "quiescence_minutes": {"const": 15}, "origins": {"const": 20}, "clients": {"const": 40}, "short_streams": {"const": 200}, "sse_streams": {"const": 20}, "websockets": {"const": 20}, "navigations_per_origin_per_minute": {"const": 2}, "abort_churn": {"const": 0.1}, "max_memory_bytes": {"type": "number", "exclusiveMinimum": 0}, "max_queue_depth": {"type": "number", "exclusiveMinimum": 0}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hardware": {"type": "object", "additionalProperties": false, "required": ["availability", "machine_model", "cpu_model", "memory_bytes"], "properties": {"availability": {"const": "available"}, "machine_model": {"type": "string", "minLength": 1}, "cpu_model": {"type": "string", "minLength": 1}, "memory_bytes": {"type": "integer", "minimum": 1}}},
    "browser_lane": {"type": "object", "additionalProperties": false, "required": ["family", "exact_build", "product_build_id", "platform", "archive_url", "archive_sha256", "binary_path", "binary_sha256", "availability"], "properties": {"family": {"enum": ["chromium", "firefox"]}, "exact_build": {"type": "string", "minLength": 1}, "product_build_id": {"type": "string", "minLength": 1}, "platform": {"const": "darwin-arm64"}, "archive_url": {"type": "string", "format": "uri"}, "archive_sha256": {"$ref": "#/$defs/sha256"}, "binary_path": {"type": "string", "minLength": 1}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "availability": {"const": "available"}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["id", "site_class", "sha256", "availability", "v1_baseline"], "properties": {"id": {"type": "string"}, "site_class": {"enum": ["content", "application", "editor_media_pwa"]}, "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "availability": {"enum": ["available", "unavailable"]}, "v1_baseline": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/v1_baseline"}]}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["unit", "source", "direction"], "properties": {"unit": {"type": "string"}, "source": {"type": "string"}, "direction": {"enum": ["minimum", "maximum"]}}},
    "site_class": {"type": "object", "additionalProperties": false, "required": ["dcl_delta", "lcp_delta", "inp_delta_ms", "cpu_delta"], "properties": {"dcl_delta": {"type": "number", "minimum": 0}, "lcp_delta": {"type": "number", "minimum": 0}, "inp_delta_ms": {"type": "number", "minimum": 0}, "cpu_delta": {"type": "number", "minimum": 0}}}
    ,"v1_baseline": {"type": "object", "additionalProperties": false, "required": ["dcl_delta", "lcp_delta", "cpu_delta"], "properties": {"dcl_delta": {"type": "number", "minimum": 0}, "lcp_delta": {"type": "number", "minimum": 0}, "cpu_delta": {"type": "number", "minimum": 0}}}
  }
}
