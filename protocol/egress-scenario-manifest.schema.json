{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egress-scenario-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surfaces", "url", "target", "allowed_dns", "expected_assertions", "settle_ms"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "url": {"type": "string", "format": "uri"},
          "target": {"type": "object", "additionalProperties": false, "required": ["host", "ports"], "properties": {"host": {"type": "string", "minLength": 1}, "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}}},
          "allowed_dns": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expected_assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ,"settle_ms": {"type": "integer", "minimum": 500, "maximum": 10000}
        }
      }
    }
  }
}
