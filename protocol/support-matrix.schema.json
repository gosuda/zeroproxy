{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroproxy.invalid/protocol/support-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "reference_platform", "claim", "browsers", "deferred_browser_families", "unsupported", "egress_surfaces", "stealth_oracle", "universal_undetectability_claim", "mathematical_no_egress_claim"],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "minLength": 1},
    "reference_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "arch"],
      "properties": {
        "os": {"const": "darwin"},
        "kernel": {"type": "string", "minLength": 1},
        "arch": {"const": "arm64"}
      }
    },
    "claim": {"const": "No direct target IP/DNS egress is known or observed through the complete, versioned, enumerated transport/navigation/execution matrix; every supported release is packet-capture tested, and unsupported surfaces are disabled or fail closed."},
    "browsers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/browser"},
      "allOf": [
        {"contains": {"type": "object", "required": ["family"], "properties": {"family": {"const": "chromium"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["family"], "properties": {"family": {"const": "firefox"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "deferred_browser_families": {"$ref": "#/$defs/uniqueStrings"},
    "unsupported": {"$ref": "#/$defs/uniqueStrings"},
    "egress_surfaces": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "stealth_oracle": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "universal_undetectability_claim": {"const": false},
    "mathematical_no_egress_claim": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "channel", "exact_build", "product_build_id", "platform", "archive_url", "archive_sha256", "binary_path", "binary_sha256", "binary_present", "shared_worker", "native_oracle_passed", "runtime_gate_passed", "transport_gate_passed", "performance_gate_passed", "soak_gate_passed", "corpus_gate_passed", "release_supported", "packet_capture_certified"],
      "properties": {
        "family": {"enum": ["chromium", "firefox"]},
        "channel": {"const": "stable"},
        "exact_build": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$"},
        "product_build_id": {"type": "string", "minLength": 1},
        "platform": {"const": "darwin-arm64"},
        "archive_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "binary_path": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_present": {"const": true},
        "shared_worker": {"type": "boolean"},
        "native_oracle_passed": {"type": "boolean"},
        "runtime_gate_passed": {"type": "boolean"},
        "transport_gate_passed": {"type": "boolean"},
        "performance_gate_passed": {"type": "boolean"},
        "soak_gate_passed": {"type": "boolean"},
        "corpus_gate_passed": {"type": "boolean"},
        "release_supported": {"type": "boolean"},
        "packet_capture_certified": {"type": "boolean"}
      }
    },
    "uniqueStrings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
