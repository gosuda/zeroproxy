{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soak-workload-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "build_tree_sha256", "manifest_sha256", "workload_server_sha256", "origins"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "build_tree_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "workload_server_sha256": {"$ref": "#/$defs/sha256"},
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "fixture_sha256"],
        "properties": {
          "origin": {"type": "string", "format": "uri"},
          "id": {"type": "string", "minLength": 1},
          "fixture_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
