{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stealth-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "claim", "universal_undetectability_claim", "browser_scope", "limits", "comparison", "surfaces"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "const": "bounded-compatibility-v2" },
    "claim": { "const": "bounded-browser-compatibility-profile-not-security-proof" },
    "universal_undetectability_claim": { "const": false },
    "browser_scope": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "exact_build", "platform"],
        "properties": {
          "family": { "enum": ["chromium", "firefox"] },
          "exact_build": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$" },
          "platform": { "const": "darwin-arm64" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_count", "probe_count", "maximum_observation_bytes", "maximum_probe_duration_ms"],
      "properties": {
        "surface_count": { "const": 12 },
        "probe_count": { "type": "integer", "minimum": 48, "maximum": 64 },
        "maximum_observation_bytes": { "const": 65536 },
        "maximum_probe_duration_ms": { "const": 5000 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_bytes", "digest", "difference_policy"],
      "properties": {
        "fixture_bytes": { "const": "identical-native-and-mediated" },
        "digest": { "const": "sha256-rfc8785-observation" },
        "difference_policy": { "const": "native-equal-or-one-exact-registry-entry" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "probes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "probes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "measurement", "expected_relation"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
                "measurement": { "enum": ["equality-graph", "descriptor-digest", "identity-matrix", "reflection-digest", "dom-observation-digest", "event-trace", "error-digest", "timing-entry-digest", "violation-trace", "state-snapshot", "url-leak-scan", "descriptor-graph-digest"] },
                "expected_relation": { "enum": ["native-equal", "owned-internal-names-absent"] }
              }
            }
          }
        }
      }
    }
  }
}
