{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolchains.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "platform", "tools", "rust_targets", "rust_libraries", "browsers", "dependency_locks"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1}
      }
    },
    "tools": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/tool"}},
    "rust_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rust_target"}},
    "rust_libraries": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/rust_library"}},
    "browsers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/browser"}},
    "dependency_locks": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "sha256", "version_args", "version_pattern"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version_args": {"type": "array", "items": {"type": "string"}},
        "version_pattern": {"type": "string", "minLength": 1},
        "archive_url": {"type": "string", "format": "uri"},
        "archive_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rust_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triple", "toolchain", "path", "tree_sha256"],
      "properties": {
        "triple": {"const": "wasm32-unknown-unknown"},
        "toolchain": {"const": "1.96.0-aarch64-apple-darwin"},
        "path": {"type": "string", "minLength": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rust_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "package_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"const": "0.2.122"},
        "package_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "exact_build", "product_build_id", "platform", "archive_url", "archive_sha256", "binary_path", "binary_sha256"],
      "properties": {
        "family": {"enum": ["chromium", "firefox"]},
        "exact_build": {"type": "string", "minLength": 1},
        "product_build_id": {"type": "string", "minLength": 1},
        "platform": {"const": "darwin-arm64"},
        "archive_url": {"type": "string", "format": "uri"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "binary_path": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
