{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostics.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/local_diagnostic" },
    { "$ref": "#/$defs/telemetry_batch" }
  ],
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "stage": { "type": "string", "enum": ["BOOTSTRAP", "COORDINATOR", "ROUTE", "POLICY", "REWRITE_HTML", "REWRITE_JS", "REWRITE_CSS", "IMPORT_MAP", "RUNTIME_INSTALL", "RELAY", "SMUX", "SOCKS", "TLS", "HTTP", "CORS", "BODY", "WEBSOCKET", "COOKIE", "STORAGE", "VIRTUAL_SERVICE_WORKER", "INTERNAL"] },
    "local_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "target_hostname", "request_id", "code", "stage"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "local" },
        "target_hostname": { "type": ["string", "null"], "maxLength": 253, "pattern": "^[^/?#@\\s]*$" },
        "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$" },
        "code": { "$ref": "#/$defs/code" },
        "stage": { "$ref": "#/$defs/stage" }
      }
    },
    "telemetry_counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "count"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "code": { "$ref": "#/$defs/code" },
        "count": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "telemetry_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "release_tuple", "counters"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "telemetry" },
        "release_tuple": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "counters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/telemetry_counter" }
        }
      }
    }
  }
}
