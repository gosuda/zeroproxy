{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "oracle_id", "sites"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "oracle_id": {"type": "string", "minLength": 1},
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "kind", "fixture_category", "fixture_sha256", "fixture_path", "entry_path", "mediated_url_template", "site_class", "native_url", "mediated_url", "actions", "compatibility_probes", "stealth_probes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "kind": {"enum": ["offline-fixture", "live-canary"]},
          "fixture_category": {"type": ["string", "null"]},
          "fixture_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "fixture_path": {"type": ["string", "null"], "minLength": 1},
          "entry_path": {"type": ["string", "null"], "minLength": 1},
          "mediated_url_template": {"type": ["string", "null"], "minLength": 1},
          "site_class": {"enum": ["content", "application", "editor_media_pwa"]},
          "native_url": {"type": ["string", "null"], "format": "uri"},
          "mediated_url": {"type": ["string", "null"], "format": "uri"},
          "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}},
          "compatibility_probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}},
          "stealth_probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "offline-fixture"}}},
            "then": {
              "properties": {
                "fixture_category": {"enum": ["react", "vue", "angular-zone", "vite-next-esm", "webpack", "jquery", "pwa", "frame", "media", "editor", "upload", "download", "article", "styled-document", "gallery", "canvas-app", "interactive-list", "toggle-control", "tab-control"]},
                "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "fixture_path": {"type": "string", "minLength": 1},
                "entry_path": {"type": "string", "minLength": 1},
                "mediated_url_template": {"type": "string", "pattern": "\\{fixture_url_encoded\\}"},
                "native_url": {"const": null},
                "mediated_url": {"const": null}
              }
            },
            "else": {"properties": {"fixture_category": {"const": null}, "fixture_sha256": {"const": null}, "fixture_path": {"const": null}, "entry_path": {"const": null}, "mediated_url_template": {"const": null}, "native_url": {"type": "string", "format": "uri"}, "mediated_url": {"type": "string", "format": "uri"}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "probe": {"type": "object", "additionalProperties": false, "required": ["id", "expression"], "properties": {"id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}}}
  }
}
